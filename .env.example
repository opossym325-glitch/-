APP_ENV=dev
APP_SECRET=change-me
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages
REDIS_DSN=redis://redis:6379

JIRA_BASE_URL=https://jira.example.test
JIRA_PROJECT_KEY=MARAUT
JIRA_ISSUE_TYPE=Эпика
JIRA_READY_STATUS=
JIRA_AUTH_TYPE=bearer
JIRA_TOKEN=
JIRA_USERNAME=
JIRA_PASSWORD=
JIRA_POLL_INTERVAL="2 minutes"
JIRA_MAX_RESULTS=50
# Подтверждённые соответствия полей, которые читает текущая внутренняя Jira-модель.
JIRA_FIELD_MAPPING={"marketplace":"customfield_13617","operationScheme":"customfield_13618","firmagName":"customfield_13619","brand":"customfield_13562","marketplaceAccountId":"customfield_13551","legalEntityId":"customfield_13583","legalEntityName":"customfield_13584","werkId":"customfield_13563","warehousesWithStock":"customfield_13549"}

# Защита первого запуска: включить только после проверки JQL и выборки на стенде.
PROCESSING_ENABLED=0
KAFKA_BROKERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=plaintext
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_MARKETPLACE_ACCOUNT_CREATE_TOPIC=mda.marketplaceAccount.create
KAFKA_MARKETPLACE_ACCOUNT_RESULTS_TOPIC=1C.marketplaceAccount.results
KAFKA_CONSUMER_GROUP=marketplace-account-automation-dev
# Dot-separated JSON path; пустое значение означает, что correlation пока извлечь нельзя.
KAFKA_RESPONSE_CORRELATION_PATH=
